{
  "manifest_version": 3,
  "name": "VPN Route Inspector",
  "version": "0.1.0",
  "description": "Local diagnostic tool for macOS split-tunnel VPN route inspection.",
  "key": "",
  "permissions": [
    "nativeMessaging"
